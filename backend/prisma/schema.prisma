// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VisitorSession {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now()) @map("created_at")
  lastActiveAt  DateTime       @updatedAt @map("last_active_at")
  islead        Boolean        @default(false) @map("is_lead")
  ip            String?
  notifications Notification[]
  lead          Lead?

  @@map("visitor_sessions")
}

model Lead {
  id                      String                   @id @default(uuid())
  budget                  Float?
  source                  String?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  visitorSessionId        String                   @unique @map("visitor_session_id")
  visitorSession          VisitorSession           @relation(fields: [visitorSessionId], references: [id])
  clients                 Client[]
  leadBehaviors           LeadBehavior[]
  propertyLeads           PropertyLead[]
  leadSegmentations       LeadSegmentation[]
  leadRecomendations      LeadRecomendation[]
  leadRecomendationCaches LeadRecomendationCache[]

  @@map("leads")
}

enum LeadEventType {
  VIEW
  LIKE
  SHARE
  Notification
}

model LeadBehavior {
  id         String        @id @default(uuid())
  eventType  LeadEventType @map("event_type")
  propertyId String        @map("property_id")
  property   Property      @relation(fields: [propertyId], references: [id])
  dwellTime  Int           @map("dwell_time")
  createdAt  DateTime      @default(now()) @map("created_at")
  leadId     String        @map("lead_id")
  lead       Lead          @relation(fields: [leadId], references: [id])

  @@map("lead_behaviors")
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

model PropertyLead {
  id                    String        @id @default(uuid())
  propertyId            String?       @map("property_id")
  leadId                String        @map("lead_id")
  property              Property?     @relation(fields: [propertyId], references: [id])
  lead                  Lead          @relation(fields: [leadId], references: [id])
  priceGap              Float?        @map("price_gap")
  engagementScore       Float?        @map("engagement_score")
  conversionProbability Float?        @map("conversion_probability")
  conversionStatus      String?       @map("conversion_status")
  urgencyLevel          UrgencyLevel? @map("urgency_level")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  leadRevenues          LeadRevenue[]

  @@unique([propertyId, leadId], name: "unique_property_lead")
  @@map("property_leads")
}

enum SegmentationType {
  CASUAL_BROWSER
  SERIOUS_BUYER
  HOT_BUYER
}

model LeadSegmentation {
  id      String           @id @default(uuid())
  leadId  String           @map("lead_id")
  lead    Lead             @relation(fields: [leadId], references: [id])
  segment SegmentationType
}

model LeadRecomendation {
  id         String   @id @default(uuid())
  leadId     String   @map("lead_id")
  lead       Lead     @relation(fields: [leadId], references: [id])
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id])
  score      Float    @map("score")
  reason     String   @map("reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("lead_recommendations")
}

model LeadRecomendationCache {
  id         String   @id @default(uuid())
  leadId     String   @map("lead_id")
  lead       Lead     @relation(fields: [leadId], references: [id])
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id])
  score      Float    @map("score")
  reason     String   @map("reason")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("lead_recommendations_cache")
}

model LeadRevenue {
  id              String       @id @default(uuid())
  propertyLeadId  String       @map("property_lead_id")
  propertyLead    PropertyLead @relation(fields: [propertyLeadId], references: [id])
  expectedRevenue Float        @map("expected_revenue")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("revenue_leads")
}

model SaleForcast {
  id                       String   @id @default(uuid())
  month                    DateTime
  predictedLeads           Int      @map("predicted_leads")
  predictedConversionsRate Float    @map("predicted_conversions_rate")
  predictedConversions     Int      @map("predicted_conversions")
  predictedRevenue         Float    @map("predicted_revenue")

  @@map("sales_forecast")
}

model User {
  id                        String         @id @default(uuid())
  email                     String         @unique
  password                  String?
  isActive                  Boolean        @default(true) @map("is_active")
  role                      UserRole       @default(CLIENT)
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")
  passwordChangedAt         DateTime?      @map("password_changed_at")
  passwordResetOtp          String?        @map("password_reset_otp")
  passwordResetExpires      DateTime?      @map("password_reset_expires")
  passwordResetToken        String?        @map("password_reset_token")
  passwordResetTokenExpires DateTime?      @map("password_reset_token_expires")
  otp                       String?
  otpExpires                DateTime?      @map("otp_expires")
  otpVerified               Boolean        @default(false) @map("otp_verified")
  signupMethod              SignupMethod   @default(EMAIL) @map("signup_method")
  googleId                  String?        @unique @map("google_id")
  employee                  Employee?
  client                    Client?
  notifications             Notification[]
  presence                  Presence?
  ownedRooms                Room[]         @relation("RoomOwner")
  roomMembers               RoomMember[]
  messages                  Message[]
  complaints                Complaint[]

  @@map("users")
}

enum UserRole {
  CLIENT
  EMPLOYEE
}

enum SignupMethod {
  EMAIL
  GOOGLE
}

model Employee {
  id                          String                       @id @default(uuid())
  name                        String
  role                        EmployeeRole                 @default(SALES)
  fullName                    String                       @map("full_name")
  location                    String
  phone                       String
  photo                       String?
  productivity                Float                        @default(0.0)
  averageResponseTime         Float                        @default(0.0) @map("average_response_time")
  preferredPropertyType       PropertyType?                @map("preferred_property_type")
  preferredLocation           String?                      @map("preferred_location")
  salary                      Decimal                      @db.Decimal(10, 2)
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  userId                      String                       @unique @map("user_id")
  user                        User                         @relation(fields: [userId], references: [id])
  schedules                   Schedule[]
  requests                    Request[]
  employeeDealRecommendations employeeDealRecommendation[]
  saleLeaseDeals              SaleLeaseDeal[]
  buyRentDeals                BuyRentDeal[]

  @@map("employees")
}

model employeeDealRecommendation {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  // dealId
  score      Float
  rank       Int
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("employee_deal_recommendations")
}

enum EmployeeRole {
  SALES
  PURCHASING
  RENTAL
  LEASE
  CONSULTANT
  SUPPORT
  SALES_MANAGER
  GENERAL_MANAGER
}

model Schedule {
  id              String         @id @default(uuid())
  type            ScheduleType
  date            DateTime
  title           String
  description     String?
  rejectOn        DateTime?      @map("rejected_on")
  acceptOn        DateTime?      @map("accept_on")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  employeeId      String         @map("employee_id")
  employee        Employee       @relation(fields: [employeeId], references: [id])
  requestId       String?        @map("request_id")
  request         Request?       @relation(fields: [requestId], references: [id])
  saleLeaseDealId String?        @map("sale_lease_deal_id")
  saleLeaseDeal   SaleLeaseDeal? @relation(fields: [saleLeaseDealId], references: [id])
  buyRentDealId   String?        @map("buy_rent_deal_id")
  buyRentDeal     BuyRentDeal?   @relation(fields: [buyRentDealId], references: [id])

  @@map("schedules")
}

enum ScheduleType {
  PERSONAL
  SALE_LEASE_DEAL
  BUY_RENT_DEAL
  REQUEST
}

model Client {
  id                     String          @id @default(uuid())
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  location               String?
  longitude              Float?
  latitude               Float?
  name                   String
  phone                  String?         @unique
  photo                  String?
  preferredLocation      String?
  minimalPreferredPrice  Int?
  maximumPreferredPrice  Int?
  preferredNumberOfRooms Int?
  favoritePropertyIds    String[]
  leadId                 String?         @map("lead_id")
  lead                   Lead?           @relation(fields: [leadId], references: [id])
  userId                 String          @unique
  user                   User            @relation(fields: [userId], references: [id])
  requests               Request[]
  properties             Property[]
  saleLeaseDeals         SaleLeaseDeal[]
  buyRentDeals           BuyRentDeal[]

  @@map("clients")
}

model Request {
  id            String        @id @default(uuid())
  type          RequestType
  status        RequestStatus @default(PENDING)
  sellData      Json?
  message       String?
  notes         Json?
  isDealCreated Boolean       @default(false) @map("is_deal_created")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  employeeId    String?       @map("employee_id")
  employee      Employee?     @relation(fields: [employeeId], references: [id])
  schedules     Schedule[]
  propertyId    String?
  property      Property?     @relation(fields: [propertyId], references: [id])

  @@map("requests")
}

enum RequestType {
  SELL
  BUY
  RENT
  LEASE
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model Property {
  id                      String                   @id @default(uuid())
  clientId                String                   @map("client_id")
  client                  Client                   @relation(fields: [clientId], references: [id])
  //CODE
  referenceCode           String?                  @unique @map("reference_code")
  zipCode                 Float                    @map("zip_code")
  // TYPE
  type                    PropertyType
  listingType             ListingType              @map("listing_type")
  // DESCRIPTION
  simpleDescription       String?                  @map("simple_description")
  fullDescription         String?                  @map("full_description")
  // LOCATION
  location                String                   @map("location")
  buildingNumber          String                   @unique
  city                    String
  address                 String?
  latitude                Float?
  longitude               Float?
  // PRICING
  rentalPeriod            Int?                     @map("rental_period")
  listedPrice             Float?                   @map("listed_price")
  actualPrice             Float?                   @map("actual_price")
  // AREA
  sqft                    Float
  // ROOMS
  roomItems               RoomItem[]
  numOfRooms              Int?                     @map("num_of_rooms")
  bathrooms               Float?                   @map("bathrooms")
  // FEATURES FOR ALL
  heating                 Status                   @default(NOT_AVAILABLE)
  furnishing              FurnishingType           @default(UNFURNISHED)
  garageCars              Float?                   @map("garage_cars")
  // FEATURES :HOUSE , VILLA
  numOfFloors             Int?                     @map("num_of_floors")
  // FEATURES :APARTMENT, HALL, STORE
  floorNumber             Int?                     @map("floor_number")
  elevator                Boolean?                 @default(false)
  parking                 Status                   @default(NOT_AVAILABLE) @map("parking")
  // EXTRA FEATURES
  fireplace               Boolean?                 @default(false)
  hasBasement             Boolean?                 @default(false)
  basementArea            Float?                   @map("basement_area")
  // IMAGES
  primaryPhoto            String                   @map("primary_photo")
  galleryPhoto            Json                     @map("gallery_photo")
  // NEARBY AMENITIES
  nearbyPlaces            Json?                    @map("nearby_places")
  // QUALITY & FINISHING 1–5
  finishingQuality        Int                      @map("finishing_quality")
  maintenanceLevel        Int                      @map("maintenance_level")
  neighborhoodScore       Float                    @map("neighborhood_score")
  exteriorFinish          Int                      @map("exterior_finish")
  overAllQual             Int                      @map("overall_qual")
  overAllcond             Int                      @map("overall_cond")
  // YEAR
  constructionYear        Int                      @map("construction_year")
  listingDate             DateTime?                @map("listing_date")
  // OUTDOOR ITEMS
  outdoorItems            OutdoorItem[]
  // STATUS
  status                  Status                   @default(NOT_AVAILABLE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  requests                Request[]
  leadBehaviors           LeadBehavior[]
  propertyLeads           PropertyLead[]
  leadRecomendations      LeadRecomendation[]
  leadRecomendationCaches LeadRecomendationCache[]
  saleLeaseDeals          SaleLeaseDeal[]
  buyRentDeals            BuyRentDeal[]

  @@map("properties")
}

model RoomItem {
  id               String   @id @default(uuid())
  type             RoomType
  size             Float
  data             Json?
  photos           Json
  description      String?
  paintDescription String
  hasBalcony       Boolean  @default(false)
  bathroomWeight   Float?
  balconyData      Json?
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id])

  @@map("room_items")
}

model OutdoorItem {
  id          String          @id @default(uuid())
  type        OutdoorItemType
  data        Json?
  description String?
  photos      Json
  propertyId  String
  property    Property        @relation(fields: [propertyId], references: [id])

  @@map("outdoor_items")
}

enum RoomType {
  BEDROOM
  MASTER_BEDROOM
  ENSUITE_BATHROOM
  BATHROOM
  LIVING_ROOM
  GUEST_BEDROOM
  FAMILY_ROOM
  KITCHEN
  DINING_ROOM
  FOYER
  POWDER_ROOM
  OTHER
}

enum OutdoorItemType {
  POOL
  GARDEN
  OUTDOOR_AREA
  EXTERNAL_GARAGE
  OTHER
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  STORE
  HALL
}

enum Status {
  AVAILABLE
  NOT_AVAILABLE
  OUT_OF_REACH
}

enum ListingType {
  SALE
  LEASE
}

enum FurnishingType {
  FULLY_FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum SaleLeaseDealType {
  SALE
  LEASE
}

enum SaleLeaseDealStatus {
  NEGOTIATING
  COMPLETED
  FAILED
}

model SaleLeaseDeal {
  id                 String              @id @default(uuid())
  maxPhasedPrice     Float               @map("max_phased_price")
  profitMargin       Float               @map("profit_margin")
  actualProfitMargin Float?              @map("actual_profit_margin")
  minListingPrice    Float               @map("min_listing_price")
  maxListingPrice    Float               @map("max_listing_price")
  actualListingPrice Float?              @map("actual_listing_price")
  propertyId         String              @map("property_id")
  property           Property            @relation(fields: [propertyId], references: [id])
  clientId           String              @map("client_id")
  client             Client              @relation(fields: [clientId], references: [id])
  employeeId         String              @map("employee_id")
  employee           Employee            @relation(fields: [employeeId], references: [id])
  dealType           SaleLeaseDealType   @map("deal_type")
  dealStatus         SaleLeaseDealStatus @default(NEGOTIATING) @map("deal_status")
  rentalPeriod       Int?                @map("rental_period")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  schedules          Schedule[]
  room               Room?               @relation("SaleLeaseDealRoom")

  @@map("sale_lease_deals")
}

enum BuyRentDealType {
  BUY
  LEASE
}

enum BuyRentDealStatus {
  FRESH
  NEGOTIATING
  COMPLETED
  FAILED
}

model BuyRentDeal {
  id         String            @id @default(uuid())
  propertyId String            @map("property_id")
  property   Property          @relation(fields: [propertyId], references: [id])
  clientId   String            @map("client_id")
  client     Client            @relation(fields: [clientId], references: [id])
  employeeId String            @map("employee_id")
  employee   Employee          @relation(fields: [employeeId], references: [id])
  dealType   BuyRentDealType   @map("deal_type")
  dealStatus BuyRentDealStatus @default(FRESH) @map("deal_status")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  schedules  Schedule[]
  room       Room?             @relation("BuyRentDealRoom")

  @@map("buy_rent_deals")
}

model Notification {
  id               String          @id @default(uuid())
  title            String
  body             String
  data             Json?
  isRead           Boolean         @default(false) @map("is_read")
  createdAt        DateTime        @default(now()) @map("created_at")
  userId           String?         @map("user_id")
  visitorSessionId String?         @map("visitor_session_id")
  entityType       entityType?     @map("entity_type")
  entityId         String?         @map("entity_id")
  user             User?           @relation(fields: [userId], references: [id])
  visitorSession   VisitorSession? @relation(fields: [visitorSessionId], references: [id])

  @@map("notifications")
}

enum entityType {
  SCHEDULE
  COMPLAINT
  DEAL
}

model Presence {
  id        String         @id @default(uuid())
  status    PresenceStatus @default(OFFLINE)
  lastSeen  DateTime?
  updatedAt DateTime       @updatedAt
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id])

  @@map("presences")
}

enum PresenceStatus {
  ONLINE
  OFFLINE
}

model Room {
  id            String       @id @default(uuid())
  name          String?
  image         String?
  description   String?
  type          RoomCategory
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  ownerId       String?
  owner         User?        @relation("RoomOwner", fields: [ownerId], references: [id])
  lastMessageId String?      @unique
  lastMessage   Message?     @relation("RoomLastMessage", fields: [lastMessageId], references: [id])
  buyRentDealId String?      @unique
  buyRentDeal   BuyRentDeal? @relation("BuyRentDealRoom", fields: [buyRentDealId], references: [id])
  saleLeaseDealId String?    @unique
  saleLeaseDeal   SaleLeaseDeal? @relation("SaleLeaseDealRoom", fields: [saleLeaseDealId], references: [id])
  roomMembers   RoomMember[]
  messages      Message[]

  @@map("rooms")
}

enum RoomCategory {
  DEAL
  INTERNAL_DIRECT
  INTERNAL_GROUP
}

model RoomMember {
  id                String   @id @default(uuid())
  lastReadMessageId String?   @map("last_read_message_id")
  joinedAt          DateTime @default(now()) @map("joined_at")
  roomId            String
  room              Room     @relation(fields: [roomId], references: [id])
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@map("room_members")
}

model Message {
  id                String   @id @default(uuid())
  message           String?
  isEdited          Boolean  @default(false) @map("is_edited")
  isDeleted         Boolean  @default(false) @map("is_deleted")
  createdAt         DateTime @default(now()) @map("created_at")
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  roomId            String
  room              Room     @relation(fields: [roomId], references: [id])
  roomAsLastMessage Room?    @relation("RoomLastMessage")

  @@map("messages")
}

model PropertyPricingPolicy {
  id                String       @id @default(uuid())
  city              String
  propertyType      PropertyType
  //
  sellProfitMargin  Float        @map("sell_profit_margin")
  rentProfitMargin  Float        @map("rent_profit_margin")
  //
  saleListingMargin Float        @map("sale_listing_margin")
  rentListingMargin Float        @map("rent_listing_margin")
  //
  saleGlobalAdjust  Float        @map("sale_global_adjust")
  rentGlobalAdjust  Float        @map("rent_global_adjust")
  //
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@unique([city, propertyType], name: "unique_city_property_type")
  @@map("property_pricing_policies")
}

enum ComplaintStatus {
  PENDING
  RESOLVED
}

enum ComplaintSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model ComplaintType {
  id                String            @id @default(uuid())
  name              String            @unique
  code              String            @unique
  severity          ComplaintSeverity
  maxResponseTime   Int
  maxResolutionTime Int
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  complaints        Complaint[]

  @@map("complaint_types")
}

model Complaint {
  id                  String          @id @default(uuid())
  status              ComplaintStatus @default(PENDING)
  issueMessage        String          @map("issue_message")
  replyMessage        String?         @map("reply_message")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  repliedAt           DateTime?       @map("replied_at")
  resolvedAt          DateTime?       @map("resolved_at")
  isResponseOverdue   Boolean         @default(false) @map("is_response_overdue")
  isResolutionOverdue Boolean         @default(false) @map("is_resolution_overdue")
  userId              String          @map("user_id")
  user                User            @relation(fields: [userId], references: [id])
  complaintTypeId     String          @map("complaint_type_id")
  complaintType       ComplaintType   @relation(fields: [complaintTypeId], references: [id])

  @@map("complaints")
}
